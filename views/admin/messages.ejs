<%- include('../partials/head', { title: 'Messages' }) %>
<div class="page-head">
  <h1>Messages</h1>
  <span class="muted"><%= messages.length %> message<%= messages.length === 1 ? '' : 's' %></span>
</div>

<% if (deleted) { %><p class="notice notice-info">Message deleted.</p><% } %>

<% if (messages.length) { %>
  <div class="message-list">
    <% messages.forEach(function (m) { %>
      <article class="card message-card">
        <header class="message-head">
          <div>
            <p class="message-from"><%= m.name %></p>
            <p class="muted small">
              <a href="mailto:<%= m.email %>"><%= m.email %></a>
              <% if (m.phone) { %> · <%= m.phone %><% } %>
              · <%= m.createdAt.toLocaleString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
            </p>
          </div>
          <span class="chip chip-small"><%= m.subject %></span>
        </header>
        <% if (m.orderNumber) { %><p class="small"><strong>Order:</strong> #<%= m.orderNumber %></p><% } %>
        <p class="message-body"><%= m.message %></p>
        <form action="/admin/messages/<%= m._id %>/delete" method="post" data-confirm="Delete this message?">
          <button type="submit" class="btn btn-small btn-danger-ghost">Delete</button>
        </form>
      </article>
    <% }) %>
  </div>
<% } else { %>
  <div class="empty-state">
    <p class="empty-emoji">✉️</p>
    <h2>No messages yet</h2>
    <p class="muted">Messages sent from the contact form will appear here.</p>
  </div>
<% } %>
<%- include('../partials/footer') %>
