<%- include('../partials/head', { title: 'Admin login' }) %>
<div class="auth-wrap">
  <form action="/admin/login" method="post" class="card form-card auth-card">
    <h1>Admin sign in</h1>
    <p class="muted">Catalog and order management.</p>
    <% if (error) { %><p class="notice notice-error"><%= error %></p><% } %>
    <label>Username
      <input type="text" name="username" required autocomplete="username">
    </label>
    <label>Password
      <input type="password" name="password" required autocomplete="current-password">
    </label>
    <button type="submit" class="btn btn-big btn-block">Sign in</button>
  </form>
</div>
<%- include('../partials/footer') %>
