<%- include('partials/head', { title: 'Home' }) %>
<section class="hero" id="top">
  <div class="hero-copy">
    <p class="eyebrow">Independent online bookstore · Since 2019</p>
    <h1>Find your next<br>favourite read.</h1>
    <p class="hero-sub">Bestselling fiction, big-idea non-fiction and books that change how you live — every one chosen by our booksellers. Order online and pay when the book reaches your door.</p>
    <form action="/books" method="get" class="hero-search">
      <input type="search" name="q" placeholder="Search by title or author…" aria-label="Search books">
      <button type="submit" class="btn">Search</button>
    </form>
    <div class="hero-links">
      <a class="btn btn-ghost" href="#books">Browse the shelf</a>
      <a class="text-link" href="#how-it-works">How it works →</a>
    </div>
  </div>
  <% const heroCovers = books.filter(function (b) { return b.image; }).slice(0, 3); %>
  <div class="hero-art" aria-hidden="true">
    <% if (heroCovers.length === 3) { %>
    <div class="cover-fan">
      <% heroCovers.forEach(function (b, i) { %>
        <a class="fan-cover fan-cover-<%= i + 1 %>" href="/books/<%= b._id %>" tabindex="-1">
          <img src="<%= b.image %>" alt="">
        </a>
      <% }) %>
    </div>
    <% } else { %>
    <div class="shelf">
      <span class="spine spine-1"></span>
      <span class="spine spine-2"></span>
      <span class="spine spine-3"></span>
      <span class="spine spine-4"></span>
      <span class="spine spine-5"></span>
    </div>
    <% } %>
  </div>
</section>

<!-- ============ BOOKS ============ -->
<section class="section" id="books">
  <div class="section-head">
    <div>
      <p class="section-kicker">The shelf</p>
      <h2 class="section-title">Our books</h2>
    </div>
    <form action="/books" method="get" class="filter-bar section-search">
      <input type="search" name="q" placeholder="Title or author…" aria-label="Search books">
      <button type="submit" class="btn">Search</button>
    </form>
  </div>

  <% if (categories.length) { %>
  <div class="chip-row">
    <a class="chip chip-active" href="#books">All <span class="chip-count"><%= books.length %></span></a>
    <% categories.forEach(function (cat) { %>
      <a class="chip" href="/books?category=<%= encodeURIComponent(cat.name) %>">
        <%= cat.name %> <span class="chip-count"><%= cat.count %></span>
      </a>
    <% }) %>
  </div>
  <% } %>

  <% if (books.length) { %>
    <div class="book-grid">
      <% books.forEach(function (book) { %>
        <%- include('partials/book-card', { book: book }) %>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <p class="empty-emoji">📚</p>
      <h3>New stock is on its way</h3>
      <p class="muted">We are restocking the shelves right now. Check back shortly, or send us a message and we will set a copy aside for you.</p>
      <a class="btn btn-ghost" href="#contact">Contact us</a>
    </div>
  <% } %>
</section>

<!-- ============ HOW IT WORKS ============ -->
<section class="section steps" id="how-it-works">
  <div class="step">
    <span class="step-number">1</span>
    <h3>Pick your books</h3>
    <p>Search the shelf and add what you like to the cart — up to 20 copies of each title.</p>
  </div>
  <div class="step">
    <span class="step-number">2</span>
    <h3>Checkout in a minute</h3>
    <p>Just your delivery details. No account, no card, no fuss.</p>
  </div>
  <div class="step">
    <span class="step-number">3</span>
    <h3>Pay on delivery</h3>
    <p>We hand you the book, you pay in cash. Track the order anytime from My Orders.</p>
  </div>
</section>

<!-- ============ ABOUT ============ -->
<section class="section" id="about">
  <div class="about-grid">
    <div class="about-copy">
      <p class="section-kicker">About us</p>
      <h2 class="section-title">A bookshop, brought online</h2>
      <p>Inkwell Lane opened in 2019 as a narrow, book-lined shop — two booksellers, a reading chair by the window and a strong opinion about every title on the shelf.</p>
      <p>Today we bring that same shop to your screen. Every book in our catalog is chosen by a bookseller who has read it, and we only stock titles we would happily hand to a friend: a short, well-chosen shelf instead of an endless warehouse.</p>
      <ul class="about-points">
        <li><strong>Hand-picked titles</strong> across fiction, self-help, finance and history</li>
        <li><strong>Packed within 24 hours</strong> and delivered in 3–6 working days</li>
        <li><strong>Free delivery</strong> on orders above ₹999</li>
        <li><strong>Easy replacements</strong> within 7 days if a book arrives damaged</li>
      </ul>
      <a class="btn" href="#books">Start browsing</a>
    </div>
    <div class="about-gallery">
      <figure class="about-photo about-photo-main">
        <img src="/images/about/store-aisle.jpg" alt="A long, warmly lit aisle of bookshelves" loading="lazy">
      </figure>
      <figure class="about-photo">
        <img src="/images/about/shop-shelves.jpg" alt="Bookshop shelves filled with travel and fiction titles" loading="lazy">
      </figure>
      <figure class="about-photo">
        <img src="/images/about/books-in-hand.jpg" alt="A hand holding a neat stack of books" loading="lazy">
      </figure>
    </div>
  </div>

  <div class="feature-grid">
    <div class="feature">
      <span class="feature-icon" aria-hidden="true">📖</span>
      <h3>Curated, not crowded</h3>
      <p>Every title is read and recommended by our booksellers before it reaches the shelf.</p>
    </div>
    <div class="feature">
      <span class="feature-icon" aria-hidden="true">💵</span>
      <h3>Cash on delivery</h3>
      <p>Order online without sharing card details. Pay only when your books arrive.</p>
    </div>
    <div class="feature">
      <span class="feature-icon" aria-hidden="true">📦</span>
      <h3>Careful packing</h3>
      <p>Books are wrapped and boxed so corners and spines arrive the way they left.</p>
    </div>
    <div class="feature">
      <span class="feature-icon" aria-hidden="true">🔄</span>
      <h3>Honest returns</h3>
      <p>Damaged or wrong title? We replace it within 7 days — no forms, no arguments.</p>
    </div>
  </div>

  <div class="about-banner">
    <img src="/images/about/book-spines.jpg" alt="" loading="lazy">
    <div class="about-banner-text">
      <p class="about-quote">“A short, well-chosen shelf beats an endless warehouse.”</p>
      <p class="about-quote-by">— The Inkwell Lane booksellers</p>
    </div>
  </div>
</section>

<!-- ============ CONTACT ============ -->
<section class="section" id="contact">
  <p class="section-kicker">Contact</p>
  <h2 class="section-title">Get in touch</h2>
  <p class="muted section-lead">Questions about an order, looking for a particular book, or just want a recommendation? Send us a message and we will reply within one working day.</p>

  <div class="contact-layout">
    <form action="/contact#contact" method="post" class="card contact-form" novalidate>
      <% if (contactSent) { %>
        <p class="notice notice-success">Thank you — your message has been sent. We will get back to you within one working day.</p>
      <% } %>
      <% if (contactErrors.length) { %>
        <div class="notice notice-error">
          <strong>Please fix the following:</strong>
          <ul><% contactErrors.forEach(function (e) { %><li><%= e %></li><% }) %></ul>
        </div>
      <% } %>
      <% const cv = contactValues; %>
      <div class="form-row">
        <label>Full name *
          <input type="text" name="name" maxlength="100" required autocomplete="name" value="<%= cv.name || '' %>" placeholder="Your name">
        </label>
        <label>Email address *
          <input type="email" name="email" maxlength="150" required autocomplete="email" value="<%= cv.email || '' %>" placeholder="you@example.com">
        </label>
      </div>
      <div class="form-row">
        <label>Phone number
          <input type="tel" name="phone" maxlength="20" autocomplete="tel" value="<%= cv.phone || '' %>" placeholder="Optional">
        </label>
        <label>Order number
          <input type="text" name="orderNumber" maxlength="20" value="<%= cv.orderNumber || '' %>" placeholder="Optional, e.g. 3F9A21C4">
        </label>
      </div>
      <label>What is this about? *
        <select name="subject" required>
          <option value="" <%= cv.subject ? '' : 'selected' %> disabled>Choose a topic</option>
          <% subjects.forEach(function (s) { %>
            <option value="<%= s %>" <%= cv.subject === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </label>
      <label>Message *
        <textarea name="message" rows="6" minlength="10" maxlength="2000" required placeholder="How can we help?"><%= cv.message || '' %></textarea>
      </label>
      <button type="submit" class="btn btn-big">Send message</button>
    </form>

    <aside class="contact-info">
      <div class="contact-info-block">
        <span class="contact-icon" aria-hidden="true">📍</span>
        <div>
          <h3>Visit the shop</h3>
          <p>XYZ Street, XYZ Area<br>XYZ City – 000000</p>
        </div>
      </div>
      <div class="contact-info-block">
        <span class="contact-icon" aria-hidden="true">📞</span>
        <div>
          <h3>Call or WhatsApp</h3>
          <p>+91 XXXXX XXXXX</p>
        </div>
      </div>
      <div class="contact-info-block">
        <span class="contact-icon" aria-hidden="true">✉️</span>
        <div>
          <h3>Email</h3>
          <p>hello@inkwelllane.in</p>
        </div>
      </div>
      <div class="contact-info-block">
        <span class="contact-icon" aria-hidden="true">🕒</span>
        <div>
          <h3>Opening hours</h3>
          <p>Monday – Saturday: 10:00 – 20:30<br>Sunday: 11:00 – 18:00</p>
        </div>
      </div>
      <div class="contact-faq">
        <h3>Quick answers</h3>
        <p><strong>How do I pay?</strong><br>Cash on delivery, always.</p>
        <p><strong>How fast is delivery?</strong><br>3–6 working days after dispatch.</p>
        <p><strong>Can I return a book?</strong><br>Yes — within 7 days if it arrives damaged or is the wrong title.</p>
      </div>
    </aside>
  </div>
</section>
<%- include('partials/footer') %>
