<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' && title ? title + ' · Inkwell Lane' : 'Inkwell Lane — Independent Bookstore' %></title>
  <meta name="description" content="Inkwell Lane is an independent online bookstore. Hand-picked fiction, non-fiction and self-help, delivered to your door with cash on delivery.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22%3E%3Ctext y=%22.9em%22 font-size=%2290%22%3E%F0%9F%93%9A%3C/text%3E%3C/svg%3E">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand"><span class="brand-mark">I</span>Inkwell Lane</a>
    <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation" aria-expanded="false">☰</button>
    <nav class="site-nav" id="siteNav">
      <a href="/#top" data-section="top" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a>
      <a href="/#books" data-section="books" class="<%= currentPath.startsWith('/books') ? 'active' : '' %>">Books</a>
      <a href="/#about" data-section="about">About</a>
      <a href="/#contact" data-section="contact">Contact</a>
      <a href="/orders" class="<%= currentPath.startsWith('/orders') ? 'active' : '' %>">My Orders</a>
      <a href="/cart" class="cart-link <%= currentPath === '/cart' ? 'active' : '' %>">
        Cart <span class="cart-badge"><%= cartCount %></span>
      </a>
      <% if (isAdmin) { %>
        <span class="nav-divider"></span>
        <a href="/admin/books">Catalog</a>
        <a href="/admin/orders">Orders</a>
        <a href="/admin/messages" class="<%= currentPath === '/admin/messages' ? 'active' : '' %>">Messages</a>
        <a href="/admin/logout">Log out</a>
      <% } %>
    </nav>
  </div>
</header>
<main class="page">
