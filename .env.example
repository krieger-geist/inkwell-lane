PORT=3000
NODE_ENV=development

# Local MongoDB (default) or your Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/inkwell-lane

# Use a long random string in production (at least 32 characters).
SESSION_SECRET=change-me-to-a-long-random-string

# Admin login for /admin/login - pick private values for production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234
